+#[cfg(test)]
+mod khavaran_network_tests {
+    use super::*;
+
+    #[test]
+    fn managed_options_win_over_saved_and_imported_values() {
+        // Inject stale disk/import values without writing any user configuration.
+        let saved = CONFIG2.read().unwrap().options.clone();
+        {
+            let mut config = CONFIG2.write().unwrap();
+            for (key, _) in KHAVARAN_NETWORK {
+                config.options.insert((*key).into(), "untrusted.invalid".into());
+            }
+        }
+        let options = Config::get_options();
+        let individual: Vec<_> = KHAVARAN_NETWORK.iter()
+            .map(|(key, _)| Config::get_option(key)).collect();
+        CONFIG2.write().unwrap().options = saved;
+        for ((key, expected), actual) in KHAVARAN_NETWORK.iter().zip(individual) {
+            assert_eq!(actual, *expected);
+            assert_eq!(options.get(*key).map(String::as_str), Some(*expected));
+        }
+        assert_eq!(Config::get_rendezvous_server(), "it-desk.khavaranai.ir:21116");
+        assert_eq!(Config::get_rendezvous_servers(), vec!["it-desk.khavaranai.ir"]);
+    }
+
+    #[test]
+    fn bulk_import_discards_network_overrides_but_keeps_other_settings() {
+        let mut options = HashMap::from([
+            ("custom-rendezvous-server".into(), "untrusted.invalid".into()),
+            ("relay-server".into(), "untrusted.invalid:21117".into()),
+            ("api-server".into(), "http://untrusted.invalid".into()),
+            ("key".into(), "wrong-key".into()),
+            ("khavaran-unrelated-test-option".into(), "preserved".into()),
+        ]);
+        Config::purify_options(&mut options);
+        assert_eq!(options.len(), 1);
+        assert_eq!(options["khavaran-unrelated-test-option"], "preserved");
+    }
+}
